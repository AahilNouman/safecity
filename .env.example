# SafeCity — Environment Configuration Template
# Copy this file to .env and insert your project credentials.

# ---------------------------------------------------------------------------
# 1. SUPABASE CENTRAL CLOUD DATABASE & STORAGE CONFIGURATION
# ---------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=incident-evidence

# ---------------------------------------------------------------------------
# 2. SERVER & NETWORK CONFIGURATION
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# 3. LEGACY LOCAL MYSQL DATABASE (FALLBACK)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=safecity_db
