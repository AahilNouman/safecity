# ============================================
# SafeCity Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git
# ============================================

# ── PostgreSQL Database ──
DATABASE_URL=postgresql://safecity_user:safecity_pass@localhost:5432/safecity_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safecity_db
DB_USER=safecity_user
DB_PASSWORD=safecity_pass

# ── Backend Server ──
PORT=3001
NODE_ENV=development

# ── JWT Authentication ──
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production
JWT_EXPIRES_IN=24h

# ── AI Service ──
AI_SERVICE_URL=http://localhost:8000

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── AI Service Config ──
AI_MODEL_PATH=app/model/saved
AI_DEMO_MODE=true
